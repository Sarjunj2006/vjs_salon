# Copy this file to .env and fill in your real values.
# Never commit the actual .env file — it contains secrets.

# --- Admin panel ---
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# --- Database (Neon Postgres) ---
# From neon.tech, after creating a project — Connection string on your dashboard.
DATABASE_URL=

# --- Image hosting (Cloudinary) ---
# From cloudinary.com dashboard, after signing up.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp (Meta Cloud API) ---
# From Meta App Dashboard > WhatsApp > API Setup (developers.facebook.com):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# A password you make up yourself, entered into Meta's webhook config screen too.
WHATSAPP_VERIFY_TOKEN=change-this-to-any-string-you-like
# Where staff booking alerts go. Digits only, country code, no '+'.
# Leave unset and it falls back to your salon's settings.phone automatically.
WHATSAPP_STAFF_NUMBER=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEPOSIT_AMOUNT_PAISE=5000
